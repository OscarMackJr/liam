    "agent_id": {"type": "string"}, "purpose": {"type": "string"}, "key_id": {"type": "string", "format": "uuid"},
    "key_expires_at_unix": {"type": "integer"}, "injected_on": {"type": "array", "items": {"type": "string"}},
    "direct_gateway": {"type": "boolean"}, "profile_version": {"type": "integer"}, "proxy_port": {"type": "integer"}, "written_at_unix": {"type": "integer"}
  }
}
